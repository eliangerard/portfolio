---
import BigIcon from "../components/BigIcon.astro";
import Glow from "../components/Glow.astro";
import Header from "../components/Header.astro";
import { data } from "../data";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = data.me.seoDescription,
	image = "/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;

const person = {
	"@type": "Person",
	"@id": `${data.me.url}/#person`,
	name: data.me.name,
	alternateName: data.me.legalName,
	jobTitle: data.me.title,
	description: data.me.about,
	url: data.me.url,
	image: socialImage,
	email: `mailto:${data.me.email}`,
	sameAs: [data.me.profiles.github, data.me.profiles.linkedin],
	address: {
		"@type": "PostalAddress",
		addressLocality: "Chihuahua",
		addressCountry: "MX",
	},
	worksFor: {
		"@type": "Organization",
		name: "AutoZone",
		url: "https://autozone.com/",
	},
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: data.education[0].subtitle,
	},
	knowsAbout: [
		...data.technologies.map((tech) => tech.name),
		...data.certifications.map((cert) => cert.issuer),
	],
	hasCredential: data.certifications.map((cert) => ({
		"@type": "EducationalOccupationalCredential",
		name: cert.name,
		credentialCategory: "certificate",
		recognizedBy: { "@type": "Organization", name: cert.issuer },
		url: cert.link,
	})),
};

// Two graphs: who the page is about, and what he has shipped.
const schema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfilePage",
			"@id": canonical,
			url: canonical,
			name: `${data.me.name} | ${data.me.title}`,
			description,
			inLanguage: "en",
			mainEntity: { "@id": `${data.me.url}/#person` },
		},
		person,
		{
			"@type": "ItemList",
			name: `Projects by ${data.me.name}`,
			itemListElement: data.projects
				.filter((project) => project.link)
				.map((project, index) => ({
					"@type": "ListItem",
					position: index + 1,
					item: {
						"@type": "CreativeWork",
						name: project.title,
						description: project.description,
						url: project.link,
						creator: { "@id": `${data.me.url}/#person` },
						keywords: project.technologies?.join(", "),
					},
				})),
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
		/>
		<meta name="author" content={data.me.legalName} />
		<meta name="theme-color" content="#042E16" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="profile" />
		<meta property="og:site_name" content={data.me.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${data.me.name}, ${data.me.title}`} />
		<meta property="og:locale" content="en_US" />
		<meta property="profile:first_name" content="Elian" />
		<meta property="profile:last_name" content="Gerard" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=MuseoModerno:wght@600;700&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(schema)}
		/>
	</head>
	<body class="relative w-full">
		<Header />

		<div class="bg-[#042E16] w-full h-full absolute z-10 overflow-hidden">
			<div class="patt w-full h-full"></div>
			<Glow class="blur-[4rem] absolute z-0 top-[-7rem] left-[-7rem] opacity-50"/>
			<Glow class="blur-[4rem] absolute z-0 top-[920px] right-[-14rem] opacity-50"/>
			<Glow class="blur-[4rem] absolute z-0 top-[1800px] left-[-7rem] opacity-50"/>
			<Glow class="blur-[4rem] absolute z-0 top-[2500px] right-[-7rem] opacity-50"/>
			<div class="glass bg-[#0007038E] w-full absolute top-0 h-full z-20">
			</div>
			<BigIcon class="opacity-50 absolute top-[-2rem] left-[-4rem] z-40 mix-blend-overlay" />
			<BigIcon class="opacity-50 absolute right-[-4rem] top-[1000px] z-40 mix-blend-overlay" />
			<BigIcon class="opacity-50 absolute left-[-4rem] top-[1900px] z-40 mix-blend-overlay" />
			<BigIcon class="opacity-50 absolute right-[-4rem] top-[2600px] z-40 mix-blend-overlay" />
		</div>
		<slot />
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
		color: white;
	}
	* {
		font-family: "Poppins", sans-serif;
	}
	.patt {
		background-size: 100%;
		opacity: 0.1;
		background-repeat: repeat;
		width: 100%;
		position: absolute;
		z-index: 0;
	}
</style>
