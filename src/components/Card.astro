---
import Dot from "../images/dot.svg";
import Link from "../ui/icons/Link.astro";

interface Props {
  title: string;
  subtitle: string;
  body?: string;
  highlights?: string[];
  list?: string[];
  date: string;
  link?: string;
}

const { title, subtitle, body, date, link, highlights, list } = Astro.props;
---

<li class="group flex items-start mb-20 w-full">
  <img
    src={Dot.src}
    class="h-5 md:h-7 mt-4 mr-3 md:mt-6 md:mr-4 md:mr-6 group-hover:rotate-[60deg] transition-all"
    alt={title}
  />
  <div class="flex-1">
    <span class="flex flex-col md:flex-row justify-between mt-2">
      <div class="flex">
        {
          link ? (
            <a
              href={link}
              target="_blank"
              class="flex items-center transition-all font-semibold text-xl my-1 underline"
            >
              {title}
              <Link />
            </a>
          ) : (
            <h3 class="font-semibold text-xl my-1">{title}</h3>
          )
        }
      </div>
      <div class="flex items-center">
        <p class="italic md:px-4 opacity-95">{date}</p>
      </div>
    </span>
    <p class="opacity-85 font-medium text-md mb-1 mt-2 md:mt-0">
      {subtitle}
    </p>
    {body && <p class="font-light opacity-75 text-md mt-1">{body}</p>}
    {
      highlights && (
        <div class="">
          <h4 class="font-medium text-lg mt-2">Highlights</h4>
          <ul class="list-disc mt-2 ml-6">
            {highlights.map((highlight) => (
              <li class="font-light opacity-75 text-md">{highlight}</li>
            ))}
          </ul>
        </div>
      )
    }
    {
      list && (
        <ul class="list-disc mt-2 ml-6">
          {list.map((item) => (
            <li class="font-light opacity-75 text-lg">{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>
